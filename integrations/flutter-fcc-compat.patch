+String? safeFurryEventUrl(dynamic value) {
+  final uri = Uri.tryParse(value?.toString().trim() ?? '');
+  if (uri == null || !['https', 'http'].contains(uri.scheme) || uri.host.isEmpty) return null;
+  final host = uri.host.toLowerCase();
+  if (host == 'furryfusion.net' || host.endsWith('.furryfusion.net')) return null;
+  return uri.toString();
+}

