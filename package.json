{
  "name": "furry-events-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild workers/sunland-data-worker/src/index.ts --bundle --format=esm --platform=browser --outfile=dist/worker.js",
    "test:db": "tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "test:postgrest": "tsx --test tests/postgrest/*.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "deno": "2.9.6",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "pg": "8.23.1",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4"
  }
}
